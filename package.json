{
  "name": "bartizan",
  "version": "0.1.0",
  "description": "Fail your CI build when a dependency has a known vulnerability. Works with npm, Yarn 1-4, pnpm and Bun. A maintained audit-ci alternative.",
  "keywords": [
    "audit",
    "audit-ci",
    "audit-ci-alternative",
    "npm-audit",
    "yarn-audit",
    "pnpm-audit",
    "bun-audit",
    "security",
    "security-gate",
    "ci",
    "cicd",
    "github-actions",
    "vulnerability",
    "vulnerability-scanner",
    "cve",
    "ghsa",
    "dependencies",
    "dependency-audit",
    "sca",
    "supply-chain",
    "supply-chain-security",
    "devsecops",
    "npm",
    "yarn",
    "pnpm",
    "bun"
  ],
  "homepage": "https://github.com/ThushanMadu/bartizan#readme",
  "bugs": "https://github.com/ThushanMadu/bartizan/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ThushanMadu/bartizan.git"
  },
  "license": "MIT",
  "author": "Thushan Madhusanka",
  "type": "module",
  "bin": {
    "bartizan": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build",
    "verify": "node scripts/verify-all.mjs",
    "verify:one": "node scripts/verify-package-manager.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
